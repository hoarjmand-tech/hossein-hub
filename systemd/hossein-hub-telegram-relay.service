[Unit]
Description=Hossein Hub Telegram Relay via Contabo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:10808 -i /opt/hossein-hub/secrets/telegram_relay_ed25519 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes root@169.58.205.88
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
