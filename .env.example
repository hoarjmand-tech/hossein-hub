PUBLIC_BASE_URL=http://192.168.1.35:8188

# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs. Empty means all users.
TELEGRAM_ALLOWED_USERS=

# Public HTTPS address opened inside Telegram.
# Example: https://archive.arjmand.xyz/telegram
TELEGRAM_MINI_APP_URL=

# Maximum accepted age of Telegram Mini App login data in seconds.
TELEGRAM_INIT_MAX_AGE=86400

# Cloudflare Zero Trust tunnel token. Keep secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional approved control agent. Keep empty until the local agent is hardened and bound to Tailscale/VPN.
WORK_AGENT_URL=
WORK_AGENT_TOKEN=
WORK_ALLOWED_TASKS=status,docker_status,docker_logs,disk_check,health,backup
